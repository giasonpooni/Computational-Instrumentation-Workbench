{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notation.systems/schemas/ciw.experiment-spec.v1.schema.json",
  "title": "ciw.experiment-spec.v1",
  "description": "Language-neutral experiment specification. Structural contract only: unit dimensions, vocabulary membership, solver capabilities and parameter references are checked by ciw.science.experiment.validate_spec and compile_spec.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "experiment_id", "title", "hypothesis", "model", "solver", "stopping", "tolerances", "invariants", "evidence"],
  "properties": {
    "schema": {"const": "ciw.experiment-spec.v1"},
    "experiment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string"},
    "hypothesis": {
      "type": "object", "additionalProperties": false, "required": ["statement"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "falsified_if": {"type": "string"},
        "competing": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "statement"],
                      "properties": {"id": {"type": "string"}, "statement": {"type": "string"}}}}
      }
    },
    "model": {
      "type": "object", "additionalProperties": false, "required": ["kind", "surface", "length_unit"],
      "properties": {
        "kind": {"enum": ["surface-geodesic", "surface-jacobi", "surface-boundary-value", "mesh-distance"]},
        "surface": {"$ref": "#/$defs/surface"},
        "length_unit": {"type": "string"},
        "frame": {"type": "string"},
        "mesh": {"type": "object"}
      }
    },
    "parameters": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
                   "additionalProperties": {"$ref": "#/$defs/quantity"}},
    "sweep": {
      "type": "object", "additionalProperties": false, "required": ["mode", "parameters"],
      "properties": {
        "mode": {"enum": ["product", "zip"]},
        "parameters": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
                       "additionalProperties": {"oneOf": [
                         {"type": "object", "additionalProperties": false, "required": ["values", "unit"],
                          "properties": {"values": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "number"}}, "unit": {"type": "string"}}},
                         {"type": "object", "additionalProperties": false, "required": ["linspace", "unit"],
                          "properties": {"linspace": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "integer", "minimum": 1, "maximum": 256}], "minItems": 3, "maxItems": 3}, "unit": {"type": "string"}}}
                       ]}}
      }
    },
    "initial_conditions": {
      "type": "object", "additionalProperties": false, "required": ["point"],
      "properties": {"point": {"$ref": "#/$defs/coordinates"}, "heading": {"$ref": "#/$defs/scalar"}, "velocity": {"type": "object"}}
    },
    "boundary": {
      "type": "object", "additionalProperties": false, "required": ["start", "target"],
      "properties": {"start": {"$ref": "#/$defs/coordinates"}, "target": {"$ref": "#/$defs/coordinates"},
                     "winding": {"oneOf": [{"type": "integer"}, {"$ref": "#/$defs/reference"}]}}
    },
    "perturbations": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["parameter", "distribution", "std"],
      "properties": {"parameter": {"const": "heading"}, "distribution": {"const": "normal"}, "std": {"$ref": "#/$defs/quantity"},
                     "samples": {"type": "integer", "minimum": 2, "maximum": 256}}}},
    "observation": {
      "type": "object", "additionalProperties": false, "required": ["observable", "noise_std", "acquisition"],
      "properties": {
        "observable": {"$ref": "#/$defs/observable"}, "synthetic_truth": {"$ref": "#/$defs/observable"},
        "noise_std": {"$ref": "#/$defs/quantity"}, "acquisition": {"enum": ["synthetic", "not_acquired", "planned"]},
        "instrument": {"type": "string"}, "frame": {"type": "string"}, "clock": {"type": "string"}, "between": {"const": "start-end"}
      }
    },
    "solver": {
      "type": "object", "additionalProperties": false, "required": ["solver_id"],
      "properties": {
        "solver_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*\\.v[1-9][0-9]*$"},
        "requires": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
        "steps": {"oneOf": [{"type": "integer", "minimum": 1}, {"$ref": "#/$defs/reference"}]},
        "settings": {"type": "object"}
      }
    },
    "tolerances": {
      "type": "object", "additionalProperties": false, "required": ["abs", "rel"],
      "properties": {"abs": {"type": "number", "minimum": 0}, "rel": {"type": "number", "minimum": 0},
                     "oracles": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false,
                                 "properties": {"abs": {"type": "number", "minimum": 0}, "rel": {"type": "number", "minimum": 0}}}}}
    },
    "invariants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "stopping": {"type": "object", "additionalProperties": false,
                 "properties": {"arclength": {"$ref": "#/$defs/scalar"}, "max_steps": {"type": "integer", "minimum": 1, "maximum": 200000},
                                "stop_at_conjugate_point": {"type": "boolean"}, "max_vertices": {"type": "integer", "minimum": 3, "maximum": 3000}}},
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["physical_measurements", "claims_sought"],
      "properties": {"physical_measurements": {"enum": ["not_acquired", "planned", "acquired"]},
                     "claims_sought": {"type": "array", "items": {"enum": ["measured", "estimated", "predicted", "computed", "verified", "interpretation"]}}}
    },
    "backend": {"type": "object", "additionalProperties": false,
                "properties": {"preferred": {"type": "array", "items": {"type": "string"}}, "precision": {"enum": ["binary64", "binary32"]},
                               "seed": {"type": "integer"}}},
    "inputs": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "reference": {"type": "string", "pattern": "^\\$[a-z][a-z0-9_]{0,63}$"},
    "quantity": {"type": "object", "additionalProperties": false, "required": ["value", "unit"],
                 "properties": {"value": {"oneOf": [{"type": "number"}, {"type": "array", "items": {"type": "number"}}]}, "unit": {"type": "string"}, "frame": {"type": "string"}}},
    "scalar": {"oneOf": [{"$ref": "#/$defs/quantity"}, {"$ref": "#/$defs/reference"}]},
    "coordinates": {"oneOf": [
      {"$ref": "#/$defs/reference"},
      {"type": "object", "additionalProperties": false, "required": ["value", "unit"],
       "properties": {"value": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"oneOf": [{"type": "number"}, {"$ref": "#/$defs/reference"}]}},
                      "unit": {"oneOf": [{"type": "string"}, {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}]}}}
    ]},
    "surface": {"type": "object", "required": ["type"],
                "properties": {"type": {"enum": ["plane", "sphere", "cylinder", "torus", "graph", "conformal", "hyperbolic-half-plane"]}}},
    "observable": {"enum": ["intrinsic_distance", "camera_chord", "image_residual", "encoder_displacement", "tracker_position",
                            "imu_orientation", "filtered_state", "reconstructed_geometry"]},
    "capability": {"enum": ["constant_curvature", "arbitrary_metric", "embedded_surfaces", "chart_transitions", "mesh_surfaces",
                            "uncertainty_propagation", "near_conjugate", "closed_form_reference", "conjugate_detection",
                            "winding_classes", "asynchronous_streams", "correlated_noise", "clock_alignment", "outlier_gating"]}
  }
}
