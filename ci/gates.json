{
  "schema": "ciw.ci-gates.v1",
  "extra_pins": {
    "icrh": {"repository": "giasonpooni/Instrument-Conformance-and-Replay-Harness",
             "revision": "dc4d826ecd1f28c1d55b724618380ce44e58bedd",
             "purpose": "independent conformance checker for the geodesic reference evidence"},
    "scout": {"repository": "notationsystems/scout-retrieval-agent",
              "revision": "5e146d5924675cd7b6e1d1ed44fb39f5da012610",
              "defined_by": "src/ciw/adapters/ppda_acquisition.py:VENDOR_REVISION",
              "purpose": "vendor gitlink inside the pinned PPDA checkout"},
    "sp1": {"repository": "succinctlabs/sp1",
            "revision": "b38b61209e45e969289e70d5cf79dc763460bc41",
            "source_tree": "7deca3aced8d8eb84dfcede98285a192c862ea4c",
            "purpose": "SP1 zkVM source for the committed heat guest recipe"},
    "exchange-ppda": {"repository": "giasonpooni/Provenance-Preserving-Data-Acquisition",
                      "revision": "a29845e13e55de30b24ae752b896058041d653e6",
                      "purpose": "exchange artifact producer (test input, not a pipeline provider)"},
    "exchange-scr": {"repository": "giasonpooni/Scientific-Computation-Runtime",
                     "revision": "5f0409743e0098a0691a88302a9b3dcdcbcf25fd",
                     "purpose": "exchange artifact producer (test input, not a pipeline provider)"}
  },
  "surfaces": [
    {"gate": "tests", "summary": "kernel, descriptor and offline pipeline tests",
     "os": ["ubuntu-latest", "windows-latest"], "python": ["3.11", "3.12"], "timeout": 30,
     "run": [["{python}", "-m", "pip", "install", "-e", ".[dev]"],
             ["{python}", "-m", "pytest", "-q"]]},
    {"gate": "installed-package", "summary": "wheel installed outside the checkout",
     "os": ["ubuntu-latest"], "python": ["3.12"], "timeout": 15, "artifacts": "dist", "artifact_name": "ciw-python-wheel",
     "run": [["{python}", "-m", "pip", "wheel", "--no-deps", ".", "--wheel-dir", "dist"],
             ["{python}", "-m", "venv", "{work}/ciw-installed"],
             ["{venv}", "-m", "pip", "install", "{glob:dist/*.whl}"],
             ["{venv}", "scripts/check_installed.py"]]},
    {"gate": "container", "summary": "container build, deploy, restart and persisted workspace",
     "os": ["ubuntu-latest"], "python": ["3.12"], "timeout": 15,
     "run": [["{python}", "-m", "pip", "install", "-e", "."],
             ["{python}", "scripts/check_container.py"]]},
    {"gate": "windows-service", "summary": "owned-process start, stop and persisted restart",
     "os": ["windows-latest"], "python": ["3.12"], "timeout": 20,
     "run": [["pwsh", "-NoProfile", "-File", "scripts/workbench.ps1", "Setup", "-PythonExecutable", "{python}"],
             ["pwsh", "-NoProfile", "-File", "scripts/check_local.ps1"]]},
    {"gate": "godot-bridge", "summary": "pinned Godot client over both WebSocket bridges",
     "os": ["ubuntu-latest"], "python": ["3.12"], "timeout": 20,
     "run": [["{python}", "-m", "pip", "install", "-e", "."],
             ["curl", "--fail", "--location", "--retry", "3",
              "https://downloads.godotengine.org/?flavor=stable&platform=linux.64&slug=linux.x86_64.zip&version=4.5.2",
              "--output", "{work}/godot.zip"],
             ["unzip", "-q", "{work}/godot.zip", "-d", "{work}/godot"],
             ["chmod", "+x", "{work}/godot/Godot_v4.5.2-stable_linux.x86_64"],
             ["{python}", "scripts/check_godot.py", "--godot", "{work}/godot/Godot_v4.5.2-stable_linux.x86_64"]]}
  ],
  "gates": [
    {"gate": "adapters", "summary": "terminal RCI, FSRT and GTE adapters with offline replay and refusal",
     "kinds": [], "providers": ["rci", "fsrt", "jspt", "gte"],
     "os": ["ubuntu-latest", "windows-latest"], "python": ["3.12"], "timeout": 15,
     "run": [["{python}", "-m", "pip", "install", "-e", ".[dev]"],
             ["{python}", "scripts/check_adapters.py"]]},
    {"gate": "plsr-terminal", "summary": "pinned PLSR package, adapter tests and installed replay",
     "kinds": [], "providers": ["plsr"],
     "os": ["ubuntu-latest", "windows-latest"], "python": ["3.12"], "timeout": 20,
     "run": [["{python}", "-m", "pip", "install", "-e", ".[dev,plsr]"],
             ["{python}", "-m", "pytest", "-q", "tests/test_plsr.py", "tests/test_plsr_engine.py"],
             ["{python}", "-m", "pip", "wheel", "--no-deps", ".", "--wheel-dir", "dist"],
             ["{python}", "-m", "pip", "uninstall", "-y", "computational-instrumentation-workbench"],
             ["{python}", "-m", "pip", "install", "--no-deps", "{glob:dist/*.whl}"],
             ["{python}", "scripts/check_plsr_installed.py"]]},
    {"gate": "calibrated-observable", "summary": "pinned calibration, alignment, observability and residual path",
     "kinds": ["calibrated-observable"],
     "os": ["ubuntu-latest"], "python": ["3.11", "3.12"], "timeout": 20,
     "run": [["{python}", "-m", "pip", "install", "-e", ".[dev]"],
             ["{python}", "scripts/check_calibrated_observable.py"]]},
    {"gate": "calibrated-window", "summary": "installed workbench with the five window providers",
     "kinds": ["calibrated-window"],
     "os": ["ubuntu-latest"], "python": ["3.11", "3.12"], "timeout": 25, "artifacts": "{output}",
     "run": [["{python}", "-m", "pip", "install", "setuptools>=77", "wheel"],
             ["{python}", "scripts/check_calibrated_window.py", "--output-dir", "{output}"]]},
    {"gate": "acquired-stream", "summary": "acquisition, calibrated window and residual monitor with eight providers",
     "kinds": ["acquired-dataset", "acquired-calibrated-window", "residual-monitor"], "extra_pins": ["scout"],
     "os": ["ubuntu-latest"], "python": ["3.12"], "timeout": 40, "artifacts": "{output}",
     "run": [["{python}", "-m", "pip", "install", "setuptools>=77", "wheel"],
             ["{python}", "scripts/check_acquired_stream.py", "--output-dir", "{output}"]]},
    {"gate": "declared-workloads", "summary": "SRA assessment and SCR integer execution with the Rust engine",
     "kinds": ["schematic-assessment", "numerical-heat"], "rust": "1.90.0",
     "os": ["ubuntu-latest"], "python": ["3.12"], "timeout": 20, "artifacts": "{output}",
     "run": [["{python}", "-m", "pip", "install", "setuptools>=77", "wheel"],
             ["{python}", "scripts/check_declared_workloads.py", "--output-dir", "{output}"]]},
    {"gate": "energy-accuracy", "summary": "energy bench records and accuracy workflow",
     "kinds": ["energy-accuracy"],
     "os": ["ubuntu-latest", "windows-latest"], "python": ["3.12"], "timeout": 15, "artifacts": "{output}",
     "artifacts_always": true,
     "run": [["{python}", "-m", "pip", "install", "setuptools>=77", "wheel"],
             ["{python}", "scripts/check_energy.py", "--output-dir", "{output}"]]},
    {"gate": "exchange", "summary": "exchange producers, pinned SET validator and read-only CLI",
     "kinds": ["instrument-exchange"], "extra_pins": ["exchange-ppda", "exchange-scr"],
     "os": ["ubuntu-latest"], "python": ["3.12"], "timeout": 10,
     "run": [["{python}", "-m", "pip", "install", "-e", ".[dev]"],
             ["{python}", "scripts/check_exchange.py", "--work", "{work}/exchange"]]},
    {"gate": "free-energy", "summary": "variational free energy with pinned CSG, GSIE and PLSR",
     "kinds": ["variational-free-energy"],
     "os": ["ubuntu-latest", "windows-latest"], "python": ["3.12"], "timeout": 30, "artifacts": "{output}",
     "artifacts_always": true,
     "run": [["{python}", "-m", "pip", "install", "setuptools>=77", "wheel"],
             ["{python}", "scripts/check_free_energy.py", "--output-dir", "{output}"]]},
    {"gate": "geodesic-references", "summary": "flat and curved references with independent ICRH checks",
     "kinds": ["flat-torus-reference", "curved-path-transfer"], "extra_pins": ["icrh"],
     "os": ["ubuntu-latest", "windows-latest"], "python": ["3.12"], "timeout": 20, "artifacts": "{output}",
     "run": [["{python}", "-m", "pip", "install", "setuptools>=77", "wheel"],
             ["{python}", "scripts/check_geodesic_references.py", "--output-dir", "{output}"]]},
    {"gate": "geometry-research", "summary": "covariance geometry, mesh path and translation flow providers",
     "kinds": ["covariance-geometry", "mesh-path", "translation-flow"],
     "os": ["ubuntu-latest", "windows-latest"], "python": ["3.12"], "timeout": 20, "artifacts": "{output}",
     "run": [["{python}", "-m", "pip", "install", "setuptools>=77", "wheel"],
             ["{python}", "scripts/check_geometry_research.py", "--output-dir", "{output}"]]},
    {"gate": "identified-design", "summary": "installed wheel against all eleven identified-design pins",
     "kinds": ["identified-design"],
     "os": ["ubuntu-latest"], "python": ["3.12"], "timeout": 35,
     "run": [["{python}", "-m", "pip", "install", "setuptools>=77", "wheel"],
             ["{python}", "scripts/check_identified_design.py"]]},
    {"gate": "integrated-modules", "summary": "companions, BIM conditioning and acquisition with exact providers",
     "kinds": ["acquired-dataset", "bim-quantity", "schematic-companions", "schematic-assessment"], "extra_pins": ["scout"],
     "os": ["ubuntu-latest"], "python": ["3.12"], "timeout": 25, "artifacts": "{output}",
     "run": [["{python}", "-m", "pip", "install", "setuptools>=77", "wheel"],
             ["{python}", "scripts/check_integrated_modules.py", "--output-dir", "{output}"]]},
    {"gate": "model-core", "summary": "Julia model worker over the SCR boundary",
     "kinds": [], "providers": ["julia-model-worker"], "linux_only_reason": "pinned Julia runtime digests exist for Linux x86-64 only",
     "apt": ["texlive-latex-base", "texlive-latex-recommended"],
     "os": ["ubuntu-latest"], "python": ["3.12"], "timeout": 75, "artifacts": "{output}",
     "run": [["{python}", "-m", "pip", "install", "setuptools>=77", "packaging>=24.2", "wheel"],
             ["{python}", "scripts/check_model_core.py", "--output-dir", "{output}"]]},
    {"gate": "proved-heat", "summary": "real SP1 proofs of the declared heat workload",
     "kinds": ["proved-heat"], "extra_pins": ["sp1"],
     "apt": ["build-essential", "clang", "libclang-dev", "libssl-dev", "pkg-config", "protobuf-compiler"],
     "apt_recommends": true,
     "os": ["ubuntu-24.04"], "python": ["3.12"], "timeout": 180, "artifacts": "{output}", "artifacts_always": true,
     "env": {"CARGO_BUILD_JOBS": "2", "CARGO_NET_GIT_FETCH_WITH_CLI": "true", "CARGO_INCREMENTAL": "0",
             "SP1_CIRCUIT_MODE": "release", "PYTHONDONTWRITEBYTECODE": "1"},
     "cache": {"toolchain": "ubuntu24.04-rust1.94.0",
               "paths": ["~/ciw-gate/proved-heat/proof-target", "~/ciw-gate/proved-heat/native-target",
                         "~/.cargo/registry", "~/.cargo/git"]},
     "preflight": [["{python}", "scripts/provision_proved_heat.py", "--resources-only", "--stack", "~/ciw-gate/proved-heat", "--output-dir", "{output}"]],
     "provision": [["{python}", "scripts/provision_proved_heat.py", "--stack", "~/ciw-gate/proved-heat", "--output-dir", "{output}"]],
     "run": [["{python}", "scripts/check_proved_heat.py",
              "--scr-repo", "~/ciw-gate/proved-heat/scr",
              "--sp1-repo", "~/ciw-gate/proved-heat/sp1-reference",
              "--engine", "~/ciw-gate/proved-heat/native-target/release/execution-cli",
              "--prover", "~/ciw-gate/proved-heat/proof-target/release/sp1-host",
              "--guest", "~/ciw-gate/proved-heat/artifacts/sp1-heat.elf",
              "--output-dir", "{output}/gate"]]},
    {"gate": "remaining-modules", "summary": "measurement chain, geometric circle and identified stability together",
     "kinds": ["measurement-chain", "geometric-circle", "identified-stability", "identified-design"],
     "os": ["ubuntu-latest"], "python": ["3.12"], "timeout": 40, "artifacts": "{output}",
     "run": [["{python}", "-m", "pip", "install", "setuptools>=77", "wheel"],
             ["{python}", "scripts/check_remaining_modules.py", "--output-dir", "{output}"]]},
    {"gate": "telemetry", "summary": "pinned PPDA, STFE, GSIE, SET and optional CBSR telemetry",
     "kinds": ["telemetry"],
     "os": ["ubuntu-latest"], "python": ["3.11", "3.12"], "timeout": 15,
     "run": [["{python}", "-m", "pip", "install", "-e", ".[dev]"],
             ["{python}", "scripts/check_telemetry.py"]]},
    {"gate": "workbench-candidates", "summary": "installed candidate workbench and both ESM replay lanes",
     "kinds": ["telemetry", "calibrated-observable"], "providers": ["esm"], "node": "22.13",
     "os": ["ubuntu-latest"], "python": ["3.12"], "timeout": 30,
     "run": [["{python}", "-m", "pip", "install", "setuptools>=77", "wheel", "numpy==2.4.3", "websockets==16.0"],
             ["{python}", "scripts/check_workbench_candidates.py"]]}
  ]
}
