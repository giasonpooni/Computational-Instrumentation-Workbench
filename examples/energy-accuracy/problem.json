{
  "schema": "ciw.energy-problem.v1",
  "problem": {
    "coordinate_system": "normalized_dimensionless",
    "prior_mean": [0.1, -0.2],
    "prior_covariance": [[1, 0.2], [0.2, 1]],
    "observation_matrix": [[1, 0.3], [-0.2, 1]],
    "observations": [2, -1],
    "noise_covariance": [[1, 0.1], [0.1, 0.7]]
  },
  "solver": {
    "initial_mean": [1, -1],
    "initial_covariance": [[1, 0.1], [0.1, 1]],
    "alpha": 0.2,
    "beta": 0.2,
    "max_iterations": 256,
    "gradient_tolerance": 1e-12,
    "precision_tolerance": 1e-12
  },
  "target_kl_nats": 1e-8
}
