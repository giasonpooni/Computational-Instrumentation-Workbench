; Computational Instrumentation Workbench / optional desktop viewport
config_version=5

[application]
config/name="Computational Instrumentation Workbench"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=850
window/size/window_width_override=1280
window/size/window_height_override=850
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.031, 0.047, 0.071, 1)
